;
; Format:
;   [section] ; section goes between []
;   param=value ; assign values to parameters

config_version=5

[application]

config/name="Dead Drop Double-Cross"
run/main_scene="res://scenes/lobby.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0.05, 0.07, 0.08, 1)
boot_splash/show_image=false
config/icon="res://icon.png"

[audio]

buses/default_bus_layout="uid://chuv1ry7fg1w2"
driver/enable_input=true

[autoload]

NetworkManager="*res://core/network_manager.gd"
EOSGRuntime="*uid://7saywdx0ipep"
HPlatform="*uid://yl2muvqrdiud"
HAuth="*uid://786t1jiowvvg"
HAchievements="*uid://bis404dty5u5c"
HFriends="*uid://uumqbey8ji5t"
HStats="*uid://dbckdip83oone"
HLeaderboards="*uid://b06khhf20mplm"
HLobbies="*uid://6iqvm33q0tb1"
HP2P="*uid://u6ae5fpm6l8q"
HSessions="*uid://bieh2rxxahuu2"
EOSManager="*res://core/eos_manager.gd"
SessionManager="*res://core/session_manager.gd"
GameConfig="*res://core/game_config.gd"
