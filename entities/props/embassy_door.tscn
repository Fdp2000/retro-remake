[ext_resource type="Script" path="res://entities/props/embassy_door.gd" id="1_door"]
[ext_resource type="Texture2D" uid="uid://ckr4c1m2b1wru" path="res://Assets/Models/Import/Interiors_A/texture/Updated_Textures/Texture_Floor.png" id="2_floor_tex"]
[ext_resource type="Texture2D" uid="uid://c8m7v4n0xp1qe" path="res://Assets/Models/Import/Interiors_A/texture/Updated_Textures/Texture_Ceiling.png" id="3_ceil_tex"]

[sub_resource type="Shader" id="Shader_comic_door"]
code = "shader_type spatial;
render_mode cull_back, diffuse_toon, specular_toon;

uniform sampler2D wood_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform sampler2D detail_tex : source_color, filter_linear_mipmap, repeat_enable;
uniform vec4 base_tint : source_color = vec4(0.46, 0.29, 0.16, 1.0);
uniform vec4 ink_color : source_color = vec4(0.07, 0.05, 0.04, 1.0);
uniform vec3 box_half_extents = vec3(0.59, 1.04, 0.034);
uniform int part_mode = 0; // 0 = door leaf, 1 = door frame, 2 = brass plate, 3 = brass handle

varying vec3 local_pos;
varying vec3 local_norm;

void vertex() {
	local_pos = VERTEX;
	local_norm = NORMAL;
}

void fragment() {
	if (part_mode == 2) {
		// Brass backplate with comic ink border and keyhole slot
		float nx = abs(local_pos.x) / max(box_half_extents.x, 0.001);
		float ny = abs(local_pos.y) / max(box_half_extents.y, 0.001);
		float border = step(0.84, max(nx, ny));
		// Keyhole circle + slot on the lower half of the plate
		float kh_circle = step(length(vec2(local_pos.x, local_pos.y + 0.038)), 0.0085);
		float kh_slot = step(abs(local_pos.x), 0.004) * step(abs(local_pos.y + 0.054), 0.016);
		float ink = clamp(border + kh_circle + kh_slot, 0.0, 1.0);
		vec3 brass = base_tint.rgb * (0.95 + 0.12 * (local_pos.y / max(box_half_extents.y, 0.01)));
		ALBEDO = mix(brass, ink_color.rgb, ink);
		ROUGHNESS = 0.32;
		METALLIC = 0.30;
	} else if (part_mode == 3) {
		// Contoured brass lever / spindle with toon rim outline
		float rim = 1.0 - clamp(dot(NORMAL, VIEW), 0.0, 1.0);
		float outline = smoothstep(0.68, 0.78, rim);
		vec3 brass = base_tint.rgb * (0.92 + 0.16 * NORMAL.y);
		ALBEDO = mix(brass, ink_color.rgb, outline);
		ROUGHNESS = 0.28;
		METALLIC = 0.38;
	} else if (part_mode == 0) {
		// Clean symmetric wood door leaf without inner square
		vec2 face_uv = vec2(
			(local_pos.x / max(box_half_extents.x, 0.001)) * 0.5 + 0.5,
			(local_pos.y / max(box_half_extents.y, 0.001)) * 0.5 + 0.5
		);
		vec2 wood_uv = vec2(face_uv.y * 1.45, face_uv.x * 0.90);
		vec3 tex_wood = texture(wood_tex, wood_uv).rgb;
		vec3 tex_det = texture(detail_tex, face_uv * 1.1).rgb;
		float grain_dark = clamp((tex_wood.r + tex_wood.g + tex_wood.b) / 3.0, 0.0, 1.0);
		float ink_stroke = smoothstep(0.32, 0.18, grain_dark);

		vec3 wood_col = base_tint.rgb * mix(0.84, 1.12, grain_dark) * mix(0.94, 1.05, tex_det.r);

		// Clean outer perimeter comic ink border in local 3D coordinates (works identically on both faces)
		float nx = abs(local_pos.x) / max(box_half_extents.x, 0.001);
		float ny = abs(local_pos.y) / max(box_half_extents.y, 0.001);
		float outer_border = step(0.955, max(nx, ny));

		float total_ink = clamp(outer_border + ink_stroke * 0.85, 0.0, 1.0);
		ALBEDO = mix(wood_col, ink_color.rgb, total_ink);
		ROUGHNESS = 0.78;
		METALLIC = 0.0;
	} else {
		// Door frame trim with wood grain & comic edge outline
		vec2 wood_uv = vec2(local_pos.y * 0.7, (local_pos.x + local_pos.z) * 1.2);
		vec3 tex_wood = texture(wood_tex, wood_uv).rgb;
		float grain_dark = clamp((tex_wood.r + tex_wood.g + tex_wood.b) / 3.0, 0.0, 1.0);
		float ink_stroke = smoothstep(0.30, 0.16, grain_dark);
		float nx = abs(local_pos.x) / max(box_half_extents.x, 0.001);
		float ny = abs(local_pos.y) / max(box_half_extents.y, 0.001);
		float nz = abs(local_pos.z) / max(box_half_extents.z, 0.001);
		float edge_count = step(0.82, nx) + step(0.985, ny) + step(0.86, nz);
		float outer_b = step(1.5, edge_count);
		vec3 frame_col = base_tint.rgb * mix(0.85, 1.10, grain_dark);
		float total_ink = clamp(outer_b + ink_stroke * 0.75, 0.0, 1.0);
		ALBEDO = mix(frame_col, ink_color.rgb, total_ink);
		ROUGHNESS = 0.82;
		METALLIC = 0.0;
	}
}
"

